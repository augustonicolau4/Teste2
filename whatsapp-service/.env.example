# ============================================================================
# autogest-whatsapp-service - variaveis de ambiente
# Copie este ficheiro para ".env" e ajuste os valores.
# ============================================================================

# --- Servico ---
NODE_ENV=development
PORT=3000

# --- Laravel (ERP autogest_nicola) ---
# URL base da aplicacao Laravel. O servico chama webhooks de callback/inbound/IA.
LARAVEL_BASE_URL=http://127.0.0.1:8000
# Segredo partilhado enviado em todos os pedidos entre servicos (header X-Service-Token).
# Deve ser IGUAL a variavel WHATSAPP_SERVICE_TOKEN em ../.env (raiz do Laravel).
SERVICE_TOKEN=change-me-service-token

# --- Evolution API (gateway WhatsApp) ---
# Documentacao: https://github.com/EvolutionAPI/evolution-api
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_INSTANCE=autogest-nicola

# --- Fila (BullMQ sobre Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Logs ---
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# --- Impressao ---
# Quando "true", tenta imprimir fisicamente via pdf-to-printer (se instalado).
# Mesmo desativado, os trabalhos ficam sempre guardados em ./spool/.
PRINTER_ENABLED=false
# Nome da impressora (vazio = impressora predefinida do sistema).
PRINTER_INTERFACE=

# --- Normalizacao de numeros (Angola) ---
DEFAULT_COUNTRY_CODE=244
