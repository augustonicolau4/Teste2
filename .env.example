# ============================================================================
# autogest_nicola - variaveis de ambiente (EXEMPLO)
# Sistema de Gestao de Oficina e Facturacao Certificada (AGT / Angola)
# ----------------------------------------------------------------------------
# Copie este ficheiro para ".env" e ajuste os valores:
#   cp .env.example .env
#   php artisan key:generate
# ============================================================================

# --- Aplicacao ---
APP_NAME=autogest_nicola
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_AO
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT
APP_TIMEZONE=Africa/Luanda

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logs ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de dados (MySQL 8+ / InnoDB) ---
# Para desenvolvimento local sem servidor MySQL pode usar-se sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autogest_nicola
DB_USERNAME=root
DB_PASSWORD=

# --- Sessao ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Fila / Cache / Ficheiros ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correio ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nicoladatec@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# autogest_nicola - Integracoes
# ----------------------------------------------------------------------
# Microsservico Node.js (WhatsApp / IA / ponte de impressao termica)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3100
# Segredo partilhado com o servico Node (header X-Service-Token).
# Deve ser IGUAL a variavel SERVICE_TOKEN em whatsapp-service/.env
WHATSAPP_SERVICE_TOKEN=change-me-service-token

# Impressora termica por omissao (Ticket 80mm)
AUTOGEST_TICKET_PRINTER=EPSON-TM-T20III

# Chave privada RSA (passphrase), usada na assinatura digital fiscal
AUTOGEST_KEY_PASSPHRASE=

# Modulo de IA (assistente WhatsApp)
AUTOGEST_AI_ENABLED=true
AUTOGEST_AI_PROVIDER=local
AUTOGEST_AI_API_KEY=
AUTOGEST_AI_ENDPOINT=
AUTOGEST_AI_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"
